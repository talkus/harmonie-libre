{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Merkabah candidate v0.3 structural schema; not a theological attestation",
  "type": "object",
  "required": [
    "project",
    "version",
    "status",
    "scenes",
    "sources",
    "nodes",
    "edges"
  ],
  "properties": {
    "project": {
      "const": "MERKABAH"
    },
    "version": {
      "const": "0.3.0-candidate"
    },
    "status": {
      "const": "PROPOSED_NOT_VALIDATED"
    },
    "scenes": {
      "type": "array",
      "items": {
        "enum": [
          "Ezekiel_1",
          "Ezekiel_10"
        ]
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "reference"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "source",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "status": {
            "enum": [
              "TEXTUAL",
              "DERIVED",
              "UNCERTAIN",
              "INTERPRETATION",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "type",
          "source"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "TEXTUAL",
              "DERIVED",
              "UNCERTAIN",
              "INTERPRETATION",
              "UNKNOWN"
            ]
          }
        }
      }
    }
  }
}
