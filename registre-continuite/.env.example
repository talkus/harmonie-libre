# Configuration du registre de continuite
# Copier en .env et adapter

# Chemin vers la base DuckDB
DUCKDB_PATH=registre.duckdb

# Chemin vers la cle privee Ed25519 (PKCS#8 chiffre)
# JAMAIS committer ce fichier
KEY_PATH=ed25519_key.pem

# ID de la cle dans le registre
KEY_ID=key_mikael_01

# Acteur
ACTOR_ID=mikael
ACTOR_ROLE=lead_auditor

# Notion (optionnel, pour l'ingestion)
# NOTION_TOKEN=secret_...

# n8n (optionnel, pour le workflow)
# N8N_WEBHOOK_URL=https://...
